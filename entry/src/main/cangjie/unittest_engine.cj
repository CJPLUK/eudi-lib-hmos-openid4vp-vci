/*
 * unittest_engine.cj — OpenHarmonyTestRunner (GENERATED by gen_ut.py; infra only,
 * NO test cases here). Reads TestReport for real pass/fail; ResultCode = 0 only
 * when failed+error == 0. Test cases live in the sibling *_suite.cj / test_cases.cj.
 */
package ohos_app_cangjie_entry

import std.unittest.*
import std.unittest.testmacro.*
import std.collection.*
import kit.PerformanceAnalysisKit.Hilog
import kit.TestKit.AbilityDelegatorRegistry
import kit.TestKit.TestRunner
import kit.AbilityKit.BundleManager
import kit.AbilityKit.BundleFlag
import kit.AbilityKit.Want

// Back-compat: some *_suite.cj expose register*Tests() that call reg(); kept so
// they still compile. onPrepare below registers classes directly (auto-listed).
public func reg(gen: () -> TestClass): Unit {
    OpenHarmonyTestRunner.testClassInstanceGenerators.add(gen)
}

public class OpenHarmonyTestRunner <: TestRunner {
    public static let testSuiteMap = HashMap<String, TestSuite>()
    public static let testClassInstanceGenerators = ArrayList<() -> TestClass>()

    private static func getDetailedInfoOf(e: Exception): String {
        "exception: ${e.toString()}"
    }

    private func executeTestClass(testClassName: String): (Int64, Int64, Int64) {
        let d = AbilityDelegatorRegistry.getAbilityDelegator()
        Hilog.info(0, "Cangjie-Test", "EXECUTE_CLASS_START: \"${testClassName}\"")
        d.print("EXECUTE_CLASS_START: \"${testClassName}\"")
        let testSuite = match (OpenHarmonyTestRunner.testSuiteMap.get(testClassName)) {
            case None => return (0, 0, 0)
            case Some(ts) => ts
        }
        var p: Int64 = 0
        var f: Int64 = 0
        var e: Int64 = 0
        try {
            let report = testSuite.runTests()
            p = report.passedCount
            f = report.failedCount
            e = report.errorCount
        } catch (ex: Exception) {
            Hilog.error(1, "Cangjie-Test", "SUITE_EXCEPTION ${testClassName}: ${ex.message}")
            e = 1
        }
        d.print("CASE_RESULT ${testClassName}: passed=${p} failed=${f}")
        Hilog.info(0, "Cangjie-Test", "EXECUTE_CLASS_END: \"${testClassName}\"")
        d.print("EXECUTE_CLASS_END: \"${testClassName}\"")
        return (p, f, e)
    }

    private func executeAllTestClasses(): (Int64, Int64, Int64) {
        var tp: Int64 = 0
        var tf: Int64 = 0
        var te: Int64 = 0
        for (name in OpenHarmonyTestRunner.testSuiteMap.keys()) {
            let (p, f, e) = executeTestClass(name)
            tp = tp + p; tf = tf + f; te = te + e
        }
        return (tp, tf, te)
    }

